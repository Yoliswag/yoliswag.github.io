{
	"servers": {
		"time": {
			"command": "docker",
			"args": [
				"run",
				"-i",
				"--rm",
				"mcp/time",
				"--local-timezone=America/New_York"
			],
			"type": "stdio"
		},
		"stitch": {
		"url": "https://stitch.googleapis.com/mcp",
		"type": "http",
			"headers": {
        		"Accept": "application/json",
        		"X-Goog-Api-Key": ""
				}
		}
	},
	"inputs": []
}